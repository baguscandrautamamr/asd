# Salin file ini menjadi .env.local, lalu isi nilainya.
# .env.local TIDAK ikut ter-commit (lihat .gitignore).

# URL project Supabase, mis. https://xxxxxxxxxxxx.supabase.co
# Supabase Studio -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=""

# Kunci anon / publishable. Aman diekspos ke browser karena setiap tabel
# dilindungi Row Level Security. JANGAN pernah menaruh service_role key di sini
# atau di file mana pun yang ikut ter-commit.
VITE_SUPABASE_ANON_KEY=""
